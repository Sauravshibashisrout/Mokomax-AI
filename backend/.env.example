# LLM
GROQ_API_KEY=your_groq_api_key

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Options: all-MiniLM-L6-v2 | BAAI/bge-large-en-v1.5 | openai
OPENAI_API_KEY=your_openai_api_key_if_using_openai_embeddings

# Chunking
CHUNKING_STRATEGY=fixed
# Options: fixed | recursive | semantic
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mokomax?retryWrites=true&w=majority

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# App
SECRET_KEY=change_this_to_a_random_secret
FRONTEND_URL=http://localhost:5173
